@misc{marmoret2026serenade,
  abbr={SERENADE},
  author={Mahamat, M. and Marmoret, A. and Cazau, D.},
  title={Unsupervised Detection of Cetacean Vocalizations by Non-Negative Matrix Factorization},
  year={2026},
  month={June},
  address={Brest},
  publisher={SERENADE Workshop},
  note = {Oral presentation. A paper based on this work is currently in preparation},
  preview={nmf-on-spectrogram.png},
  abstract={Passive acoustic monitoring provides a non-invasive way to study cetacean vocalizations, but the resulting recordings also contain substantial environmental and anthropogenic noise. We propose an unsupervised pipeline for detecting biological signals without relying on manually annotated data. The method combines Non-Negative Matrix Factorization for spectral decomposition with the Pruned Exact Linear Time algorithm for temporal segmentation. Experiments on real marine mammal recordings from Antarctica show that the approach can identify cetacean vocalizations while remaining interpretable and applicable to large-scale datasets. Although its performance remains below that of supervised deep learning baselines, it substantially reduces the annotation requirements and offers a practical alternative for bioacoustic analysis. Available on HAL: https://hal.science/hal-05668390v1},
  url={https://hal.science/hal-05668390v1},
  hal={https://hal.science/hal-05668390v1},
  pdf={Détection non supervisée de vocalisations de baleines par factorisation de matrices non négatives et segmentation temporelle.pdf}
}
